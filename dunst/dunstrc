# Kanagawa theme, matching qtile/module/kanagawa.py.
# Written for dunst 1.9 (Ubuntu 24.04). See `man 5 dunst` for every option.

[global]
    # Show on whichever monitor has the mouse
    follow = mouse

    # Geometry: top-right, just under the 25px bar and its 5px margin
    width = 360
    height = 300
    origin = top-right
    offset = 12x37
    notification_limit = 5

    # Progress bar (used by volume, brightness and similar hints)
    progress_bar = true
    progress_bar_height = 8
    progress_bar_frame_width = 1
    progress_bar_min_width = 150
    progress_bar_max_width = 340

    # Appearance
    indicate_hidden = yes
    transparency = 0
    separator_height = 2
    separator_color = frame
    padding = 10
    horizontal_padding = 12
    text_icon_padding = 10
    frame_width = 2
    gap_size = 6
    corner_radius = 6
    sort = yes

    # Text
    font = FiraCode Nerd Font 10
    line_height = 0
    markup = full
    format = "<b>%s</b>\n%b"
    alignment = left
    vertical_alignment = center
    show_age_threshold = 60
    ellipsize = middle
    ignore_newline = no
    stack_duplicates = true
    hide_duplicate_count = false
    show_indicators = yes

    # Icons (same theme as GTK)
    icon_theme = "Papirus-Dark, Papirus"
    enable_recursive_icon_lookup = true
    icon_position = left
    min_icon_size = 32
    max_icon_size = 48

    # History (Mod+b brings notifications back)
    sticky_history = yes
    history_length = 50

    # Programs
    dmenu = /usr/bin/rofi -dmenu -p dunst
    browser = /usr/bin/xdg-open

    # Mouse
    # Left click opens the app (needs Qtile's focus_on_window_activation = "focus")
    mouse_left_click = do_action, close_current
    mouse_middle_click = close_all
    mouse_right_click = close_current

    title = Dunst
    class = Dunst

[urgency_low]
    background = "#1F1F28"
    foreground = "#C8C093"
    frame_color = "#54546D"
    highlight = "#54546D"
    timeout = 4

[urgency_normal]
    background = "#1F1F28"
    foreground = "#DCD7BA"
    frame_color = "#7e9cd8"
    highlight = "#7e9cd8"
    timeout = 8

[urgency_critical]
    background = "#1F1F28"
    foreground = "#DCD7BA"
    frame_color = "#c34043"
    highlight = "#c34043"
    # Stay on screen until dismissed
    timeout = 0
