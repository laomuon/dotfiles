# Keep the system defaults
$include /etc/inputrc

# Show the vi mode before the prompt, in bash only.
# Without $if, other readline tools like the Python REPL would show a marker too.
$if Bash
    set show-mode-in-prompt on
    set vi-ins-mode-string "\1\e[38;2;118;148;106m\2[I]\1\e[0m\2 "
    set vi-cmd-mode-string "\1\e[38;2;192;163;110m\2[N]\1\e[0m\2 "
$endif
